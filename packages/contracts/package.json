{
  "name": "@qr-evals/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated JSON Schema → TypeScript types + zod for the qr-llm-evals API. src/generated is written by scripts/export_schemas.py.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts --schema-dir schema --out-dir src/generated",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
