{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UsageResponse.json",
  "$defs": {
    "BillingView": {
      "additionalProperties": false,
      "properties": {
        "outstanding_microusd": {
          "description": "Priced lifetime usage minus recorded payments, in 1e-6 USD.",
          "title": "Outstanding Microusd",
          "type": "integer"
        },
        "paid_microusd": {
          "title": "Paid Microusd",
          "type": "integer"
        },
        "prices": {
          "$ref": "#/$defs/PricesView"
        },
        "settlements": {
          "description": "Newest first (20 at most).",
          "items": {
            "$ref": "#/$defs/SettlementView"
          },
          "title": "Settlements",
          "type": "array"
        }
      },
      "required": [
        "outstanding_microusd",
        "paid_microusd",
        "prices",
        "settlements"
      ],
      "title": "BillingView",
      "type": "object"
    },
    "PricesView": {
      "additionalProperties": false,
      "description": "US dollars per million tokens.",
      "properties": {
        "qrng_input": {
          "minimum": 0,
          "title": "Qrng Input",
          "type": "number"
        },
        "qrng_output": {
          "minimum": 0,
          "title": "Qrng Output",
          "type": "number"
        },
        "prng_input": {
          "minimum": 0,
          "title": "Prng Input",
          "type": "number"
        },
        "prng_output": {
          "minimum": 0,
          "title": "Prng Output",
          "type": "number"
        }
      },
      "required": [
        "qrng_input",
        "qrng_output",
        "prng_input",
        "prng_output"
      ],
      "title": "PricesView",
      "type": "object"
    },
    "QuotaView": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Lifetime token budget; 0 = unlimited.",
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        },
        "remaining": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when unlimited.",
          "title": "Remaining"
        },
        "exhausted": {
          "title": "Exhausted",
          "type": "boolean"
        }
      },
      "required": [
        "limit",
        "used",
        "remaining",
        "exhausted"
      ],
      "title": "QuotaView",
      "type": "object"
    },
    "SettlementView": {
      "additionalProperties": false,
      "properties": {
        "amount_microusd": {
          "title": "Amount Microusd",
          "type": "integer"
        },
        "settled_at": {
          "format": "date-time",
          "title": "Settled At",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "amount_microusd",
        "settled_at",
        "note"
      ],
      "title": "SettlementView",
      "type": "object"
    },
    "UsageBucketView": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "totals": {
          "$ref": "#/$defs/UsageTotalsView"
        }
      },
      "required": [
        "key",
        "totals"
      ],
      "title": "UsageBucketView",
      "type": "object"
    },
    "UsageTotalsView": {
      "additionalProperties": false,
      "description": "Tokens by lane. Input = prompt tokens, output = generated tokens.",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "qrng_input": {
          "description": "Shared engine, quantum arm.",
          "minimum": 0,
          "title": "Qrng Input",
          "type": "integer"
        },
        "qrng_output": {
          "minimum": 0,
          "title": "Qrng Output",
          "type": "integer"
        },
        "prng_input": {
          "description": "Shared engine, every other call.",
          "minimum": 0,
          "title": "Prng Input",
          "type": "integer"
        },
        "prng_output": {
          "minimum": 0,
          "title": "Prng Output",
          "type": "integer"
        },
        "own_key_tokens": {
          "description": "Input + output on the user's own provider key; not billed here.",
          "minimum": 0,
          "title": "Own Key Tokens",
          "type": "integer"
        },
        "cost_microusd": {
          "description": "Price of the four billed numbers, in 1e-6 USD.",
          "minimum": 0,
          "title": "Cost Microusd",
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "qrng_input",
        "qrng_output",
        "prng_input",
        "prng_output",
        "own_key_tokens",
        "cost_microusd"
      ],
      "title": "UsageTotalsView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "quota": {
      "$ref": "#/$defs/QuotaView"
    },
    "billing": {
      "$ref": "#/$defs/BillingView"
    },
    "totals": {
      "$ref": "#/$defs/UsageTotalsView"
    },
    "by_kind": {
      "description": "generation / judge / narrative.",
      "items": {
        "$ref": "#/$defs/UsageBucketView"
      },
      "title": "By Kind",
      "type": "array"
    },
    "by_source": {
      "description": "Generations by provenance source label (quantum vs the PRNG arms).",
      "items": {
        "$ref": "#/$defs/UsageBucketView"
      },
      "title": "By Source",
      "type": "array"
    },
    "by_day": {
      "description": "UTC days, newest first (30 at most).",
      "items": {
        "$ref": "#/$defs/UsageBucketView"
      },
      "title": "By Day",
      "type": "array"
    },
    "by_run": {
      "description": "Most recent runs first (20 at most).",
      "items": {
        "$ref": "#/$defs/UsageBucketView"
      },
      "title": "By Run",
      "type": "array"
    }
  },
  "required": [
    "quota",
    "billing",
    "totals",
    "by_kind",
    "by_source",
    "by_day",
    "by_run"
  ],
  "title": "UsageResponse",
  "type": "object"
}
