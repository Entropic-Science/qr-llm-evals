{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SessionJoinResponse.json",
  "$defs": {
    "Observer": {
      "additionalProperties": false,
      "description": "One line of ``observers.jsonl`` (pseudonymous, spec D-13).",
      "properties": {
        "observer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observer Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "joined_at": {
          "format": "date-time",
          "title": "Joined At",
          "type": "string"
        },
        "consent_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent At"
        }
      },
      "required": [
        "observer_id",
        "run_id",
        "display_name",
        "joined_at"
      ],
      "title": "Observer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observer": {
      "$ref": "#/$defs/Observer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "pre_required": {
      "default": true,
      "title": "Pre Required",
      "type": "boolean"
    }
  },
  "required": [
    "observer",
    "session_id"
  ],
  "title": "SessionJoinResponse",
  "type": "object"
}
