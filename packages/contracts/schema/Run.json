{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Run.json",
  "$defs": {
    "ArmProgress": {
      "additionalProperties": false,
      "properties": {
        "by_card": {
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "$ref": "#/$defs/CardProgress"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "By Card",
          "type": "object"
        }
      },
      "title": "ArmProgress",
      "type": "object"
    },
    "ArmReadiness": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resolved_qr_args": {
          "additionalProperties": true,
          "description": "The qr_* envelope the engine accepted for this arm.",
          "title": "Resolved Qr Args",
          "type": "object"
        }
      },
      "required": [
        "available"
      ],
      "title": "ArmReadiness",
      "type": "object"
    },
    "CardProgress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "default": 0,
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "aborted": {
          "default": 0,
          "minimum": 0,
          "title": "Aborted",
          "type": "integer"
        }
      },
      "title": "CardProgress",
      "type": "object"
    },
    "EntropyHealth": {
      "additionalProperties": false,
      "description": "Snapshot of ``GET /health/entropy`` (spec §2.7 step 1).",
      "properties": {
        "rpc_ok": {
          "title": "Rpc Ok",
          "type": "boolean"
        },
        "currently_degraded": {
          "title": "Currently Degraded",
          "type": "boolean"
        },
        "fallback_count": {
          "minimum": 0,
          "title": "Fallback Count",
          "type": "integer"
        },
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        }
      },
      "required": [
        "rpc_ok",
        "currently_degraded",
        "fallback_count"
      ],
      "title": "EntropyHealth",
      "type": "object"
    },
    "Halt": {
      "additionalProperties": false,
      "description": "One stop of a run by a result check, kept in ``Run.halts``.\n\nA stop is a pause with a stored reason: nothing is removed and nothing\nresumes by itself. ``resumed_at`` is empty while the halt is open and is\nstamped by the run that the host resumes.\n\nA halt is written to ``run.json``, sent as an event and served on open\nroutes, so it must never hold a key (AGENTS.md invariant 3). The record\nsees to that itself: its text passes through the log redaction, and a\ncause or count is kept under its own name only when that name has the\nshape of one the harness writes. Free text, such as an upstream error\nmessage, is tallied as :data:`OTHER_CAUSE`.",
      "properties": {
        "rule": {
          "enum": [
            "generation_errors",
            "entropy_degraded",
            "tier0_failed",
            "scorer_errors",
            "empty_outputs",
            "nothing_parsed",
            "unfinished",
            "judge_rejected",
            "judge_unusable",
            "nothing_judged",
            "judge_phase_error"
          ],
          "title": "Rule",
          "type": "string"
        },
        "scope": {
          "enum": [
            "arm",
            "card",
            "phase",
            "run"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scope_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The arm or the card the rule fired for; empty otherwise.",
          "title": "Scope Id"
        },
        "phase": {
          "enum": [
            "preflight",
            "generation",
            "judge"
          ],
          "title": "Phase",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "sentence": {
          "description": "What the rule saw, with the real scope and counts.",
          "title": "Sentence",
          "type": "string"
        },
        "recovery": {
          "description": "What Resume can and cannot recover after this stop.",
          "title": "Recovery",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "causes": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "A tally by cause in the harness's own words (an HTTP status, a class name).",
          "title": "Causes",
          "type": "object"
        },
        "sample_refs": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Sample Refs",
          "type": "array"
        },
        "resumed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resumed At"
        }
      },
      "required": [
        "rule",
        "scope",
        "phase",
        "at",
        "sentence",
        "recovery"
      ],
      "title": "Halt",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "by_arm": {
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "$ref": "#/$defs/ArmProgress"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "By Arm",
          "type": "object"
        }
      },
      "title": "Progress",
      "type": "object"
    },
    "ReadinessReport": {
      "additionalProperties": false,
      "description": "Result of ``POST /api/readiness`` (spec §2.7).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "entropy": {
          "$ref": "#/$defs/EntropyHealth"
        },
        "arms": {
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "$ref": "#/$defs/ArmReadiness"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Arms",
          "type": "object"
        },
        "equivalence_ok": {
          "description": "All qr-llm arms differ only in entropy source / seed / epsilon.",
          "title": "Equivalence Ok",
          "type": "boolean"
        },
        "determinism_tier": {
          "enum": [
            "none",
            "sampling_deterministic",
            "serialized_replay",
            "load_invariant"
          ],
          "title": "Determinism Tier",
          "type": "string"
        },
        "tier0_source": {
          "enum": [
            "engine_log",
            "api_logprobs"
          ],
          "title": "Tier0 Source",
          "type": "string"
        },
        "epsilon_supported": {
          "title": "Epsilon Supported",
          "type": "boolean"
        },
        "measured_tps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Tps"
        }
      },
      "required": [
        "at",
        "entropy",
        "equivalence_ok",
        "determinism_tier",
        "tier0_source",
        "epsilon_supported"
      ],
      "title": "ReadinessReport",
      "type": "object"
    },
    "Taint": {
      "additionalProperties": false,
      "description": "A sample or window whose quantum claim (or integrity) is compromised.",
      "properties": {
        "sample_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Ref"
        },
        "window_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Id"
        },
        "kind": {
          "enum": [
            "engine_fallback",
            "qrng_degraded",
            "stateless_row",
            "stream_error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "title": "Taint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``runs/<run_id>/run.json``. Secrets never appear here: ``keys_present`` only.",
  "properties": {
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "study_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "pilot",
        "full"
      ],
      "title": "Kind",
      "type": "string"
    },
    "state": {
      "default": "created",
      "enum": [
        "created",
        "ready",
        "running",
        "paused",
        "needs_keys",
        "analysing",
        "complete",
        "aborted"
      ],
      "title": "State",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "key_name": {
      "description": "Name of the launch key that gated the run (never the key).",
      "title": "Key Name",
      "type": "string"
    },
    "owner_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Account that launched the run; None for a run launched with a bare key.",
      "title": "Owner Id"
    },
    "host_token_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Host Token Hash",
      "type": "string"
    },
    "prereg_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prereg Hash"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "prereg_stale": {
      "default": false,
      "title": "Prereg Stale",
      "type": "boolean"
    },
    "readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReadinessReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tier0_source": {
      "anyOf": [
        {
          "enum": [
            "engine_log",
            "api_logprobs"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier0 Source"
    },
    "determinism_tier": {
      "default": "none",
      "enum": [
        "none",
        "sampling_deterministic",
        "serialized_replay",
        "load_invariant"
      ],
      "title": "Determinism Tier",
      "type": "string"
    },
    "progress": {
      "$ref": "#/$defs/Progress"
    },
    "taints": {
      "items": {
        "$ref": "#/$defs/Taint"
      },
      "title": "Taints",
      "type": "array"
    },
    "withdrawn": {
      "default": false,
      "title": "Withdrawn",
      "type": "boolean"
    },
    "needs_keys": {
      "default": false,
      "title": "Needs Keys",
      "type": "boolean"
    },
    "keys_present": {
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "e.g. {'judge': true, 'openai': false}.",
      "title": "Keys Present",
      "type": "object"
    },
    "halts": {
      "description": "Every stop of the run by a result check, oldest first; never shortened.",
      "items": {
        "$ref": "#/$defs/Halt"
      },
      "title": "Halts",
      "type": "array"
    },
    "checks_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Version of the result checks the run started under; empty for a run made before result checks.",
      "title": "Checks Version"
    }
  },
  "required": [
    "run_id",
    "study_id",
    "kind",
    "created_at",
    "key_name",
    "host_token_hash",
    "config_hash"
  ],
  "title": "Run",
  "type": "object"
}
