{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RunControlResponse.json",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "start",
        "pause",
        "resume",
        "abort"
      ],
      "title": "Action",
      "type": "string"
    },
    "state": {
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "action",
    "state"
  ],
  "title": "RunControlResponse",
  "type": "object"
}
