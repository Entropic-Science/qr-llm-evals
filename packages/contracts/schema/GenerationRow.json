{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GenerationRow.json",
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a sample's randomness came from (spec §4.4, AGENTS.md invariant 2).",
      "properties": {
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "served_name": {
          "title": "Served Name",
          "type": "string"
        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "sampling": {
          "enum": [
            "creative",
            "t1_minp",
            "greedy"
          ],
          "title": "Sampling",
          "type": "string"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "qr_preset sent, if a qr-llm target.",
          "title": "Preset"
        },
        "envelope_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Hash",
          "type": "string"
        },
        "source_label": {
          "enum": [
            "quantum",
            "seeded_prng",
            "system_prng",
            "seeded_prng_biased",
            "provider_prng"
          ],
          "title": "Source Label",
          "type": "string"
        },
        "quantum": {
          "title": "Quantum",
          "type": "boolean"
        },
        "study_seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Seed"
        },
        "qr_seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qr Seed"
        },
        "epsilon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epsilon"
        },
        "engine_fallback_delta": {
          "default": 0,
          "minimum": 0,
          "title": "Engine Fallback Delta",
          "type": "integer"
        },
        "engine_degraded": {
          "default": false,
          "title": "Engine Degraded",
          "type": "boolean"
        },
        "engine_last_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Last Source"
        },
        "determinism_tier": {
          "enum": [
            "none",
            "sampling_deterministic",
            "serialized_replay",
            "load_invariant"
          ],
          "title": "Determinism Tier",
          "type": "string"
        },
        "pipeline_pinned": {
          "title": "Pipeline Pinned",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "served_name",
        "sampling",
        "envelope_hash",
        "source_label",
        "quantum",
        "determinism_tier",
        "pipeline_pinned"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "started": {
          "format": "date-time",
          "title": "Started",
          "type": "string"
        },
        "first_token": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token"
        },
        "finished": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished"
        },
        "tps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tps"
        }
      },
      "required": [
        "started"
      ],
      "title": "Timing",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One line of ``generations.jsonl``.",
  "properties": {
    "sample_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Sample Ref",
      "type": "string"
    },
    "arm_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Arm Id",
      "type": "string"
    },
    "card_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Card Id",
      "type": "string"
    },
    "prompt_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "epoch": {
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "told_condition": {
      "anyOf": [
        {
          "enum": [
            "told_qrng",
            "told_prng",
            "told_nothing"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Told Condition"
    },
    "messages_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Messages Hash",
      "type": "string"
    },
    "output": {
      "title": "Output",
      "type": "string"
    },
    "thinking": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thinking"
    },
    "finish_reason": {
      "enum": [
        "stop",
        "length",
        "abort",
        "error"
      ],
      "title": "Finish Reason",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "timing": {
      "$ref": "#/$defs/Timing"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "window": {
      "default": "unsupervised",
      "enum": [
        "supervised",
        "break",
        "unsupervised"
      ],
      "title": "Window",
      "type": "string"
    },
    "qr_seed": {
      "anyOf": [
        {
          "exclusiveMaximum": 9223372036854775808,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qr Seed"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "sample_ref",
    "arm_id",
    "card_id",
    "prompt_id",
    "epoch",
    "messages_hash",
    "output",
    "finish_reason",
    "provenance",
    "timing",
    "request_id"
  ],
  "title": "GenerationRow",
  "type": "object"
}
