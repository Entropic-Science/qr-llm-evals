{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AnalyseResponse.json",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "state": {
      "const": "analysing",
      "default": "analysing",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "study_id",
    "analysis_id"
  ],
  "title": "AnalyseResponse",
  "type": "object"
}
