{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdminUsersResponse.json",
  "$defs": {
    "AdminUserView": {
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/$defs/UserView"
        },
        "disabled": {
          "title": "Disabled",
          "type": "boolean"
        },
        "token_quota": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-account override; None = the default.",
          "title": "Token Quota"
        },
        "quota": {
          "$ref": "#/$defs/QuotaView"
        },
        "totals": {
          "$ref": "#/$defs/UsageTotalsView"
        },
        "outstanding_microusd": {
          "title": "Outstanding Microusd",
          "type": "integer"
        },
        "storage_bytes": {
          "description": "Disk used by the account's run artifacts.",
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        }
      },
      "required": [
        "user",
        "disabled",
        "token_quota",
        "quota",
        "totals",
        "outstanding_microusd",
        "storage_bytes"
      ],
      "title": "AdminUserView",
      "type": "object"
    },
    "PricesView": {
      "additionalProperties": false,
      "description": "US dollars per million tokens.",
      "properties": {
        "qrng_input": {
          "minimum": 0,
          "title": "Qrng Input",
          "type": "number"
        },
        "qrng_output": {
          "minimum": 0,
          "title": "Qrng Output",
          "type": "number"
        },
        "prng_input": {
          "minimum": 0,
          "title": "Prng Input",
          "type": "number"
        },
        "prng_output": {
          "minimum": 0,
          "title": "Prng Output",
          "type": "number"
        }
      },
      "required": [
        "qrng_input",
        "qrng_output",
        "prng_input",
        "prng_output"
      ],
      "title": "PricesView",
      "type": "object"
    },
    "QuotaView": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Lifetime token budget; 0 = unlimited.",
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        },
        "remaining": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when unlimited.",
          "title": "Remaining"
        },
        "exhausted": {
          "title": "Exhausted",
          "type": "boolean"
        }
      },
      "required": [
        "limit",
        "used",
        "remaining",
        "exhausted"
      ],
      "title": "QuotaView",
      "type": "object"
    },
    "UsageTotalsView": {
      "additionalProperties": false,
      "description": "Tokens by lane. Input = prompt tokens, output = generated tokens.",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "qrng_input": {
          "description": "Shared engine, quantum arm.",
          "minimum": 0,
          "title": "Qrng Input",
          "type": "integer"
        },
        "qrng_output": {
          "minimum": 0,
          "title": "Qrng Output",
          "type": "integer"
        },
        "prng_input": {
          "description": "Shared engine, every other call.",
          "minimum": 0,
          "title": "Prng Input",
          "type": "integer"
        },
        "prng_output": {
          "minimum": 0,
          "title": "Prng Output",
          "type": "integer"
        },
        "own_key_tokens": {
          "description": "Input + output on the user's own provider key; not billed here.",
          "minimum": 0,
          "title": "Own Key Tokens",
          "type": "integer"
        },
        "cost_microusd": {
          "description": "Price of the four billed numbers, in 1e-6 USD.",
          "minimum": 0,
          "title": "Cost Microusd",
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "qrng_input",
        "qrng_output",
        "prng_input",
        "prng_output",
        "own_key_tokens",
        "cost_microusd"
      ],
      "title": "UsageTotalsView",
      "type": "object"
    },
    "UserView": {
      "additionalProperties": false,
      "description": "What the API says about an account. No password hash, no key, no key digest.",
      "properties": {
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        },
        "key_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The linked key's name in the keys file, if known.",
          "title": "Key Name"
        },
        "key_fingerprint": {
          "description": "First 8 hex of the linked key's SHA-256.",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "key_linked_at": {
          "format": "date-time",
          "title": "Key Linked At",
          "type": "string"
        },
        "is_admin": {
          "title": "Is Admin",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "username",
        "key_name",
        "key_fingerprint",
        "key_linked_at",
        "is_admin",
        "created_at"
      ],
      "title": "UserView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "default_token_quota": {
      "minimum": 0,
      "title": "Default Token Quota",
      "type": "integer"
    },
    "prices": {
      "$ref": "#/$defs/PricesView"
    },
    "disk_free_bytes": {
      "description": "Free space on the data volume.",
      "minimum": 0,
      "title": "Disk Free Bytes",
      "type": "integer"
    },
    "disk_total_bytes": {
      "minimum": 0,
      "title": "Disk Total Bytes",
      "type": "integer"
    },
    "users": {
      "items": {
        "$ref": "#/$defs/AdminUserView"
      },
      "title": "Users",
      "type": "array"
    }
  },
  "required": [
    "default_token_quota",
    "prices",
    "disk_free_bytes",
    "disk_total_bytes",
    "users"
  ],
  "title": "AdminUsersResponse",
  "type": "object"
}
