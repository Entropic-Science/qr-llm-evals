{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "JudgeRow.json",
  "$defs": {
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One line of ``judge/<judge_id>.jsonl``.",
  "properties": {
    "sample_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Sample Ref",
      "type": "string"
    },
    "judge_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Judge Id",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "rubric_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Hash",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "raw": {
      "default": "",
      "title": "Raw",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    }
  },
  "required": [
    "sample_ref",
    "judge_id",
    "model",
    "rubric_hash",
    "at"
  ],
  "title": "JudgeRow",
  "type": "object"
}
