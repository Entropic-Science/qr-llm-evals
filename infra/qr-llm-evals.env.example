# Install as root:root 0600 /etc/qr-llm-evals/qr-llm-evals.env.
# systemd reads this file before changing user; no provider/judge keys here.
QR_EVALS_VLLM_ORIGIN=http://127.0.0.1:8000
QR_EVALS_EDGE_ORIGIN=http://127.0.0.1:8820
QR_EVALS_KEY_VERIFY=file
QR_EVALS_KEYS_FILE=/etc/qr-llm-api/api-keys.json
QR_EVALS_MAX_ACTIVE_RUNS_PER_KEY=1
QR_EVALS_MAX_INFLIGHT=3
QR_EVALS_SIGNUP_ENABLED=1
QR_EVALS_SESSION_TTL_HOURS=168
QR_EVALS_PRIORITY=0
QR_EVALS_DATA_DIR=/var/lib/qr-llm-evals
# Leave empty until DEP-1 lands and the service user has read access.
QR_EVALS_TOKEN_LOG_DIR=
QR_EVALS_TIER2_REPLAY_ACTIVE=0
QR_EVALS_BIND_HOST=127.0.0.1
QR_EVALS_BIND_PORT=8830
QR_EVALS_CORS_ORIGINS=https://evals.entropic.science
QR_EVALS_LOG_LEVEL=INFO
# QR_EVALS_COMMIT is supplied by the release, never hand-set here.
